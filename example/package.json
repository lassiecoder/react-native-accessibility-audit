{
  "name": "react-native-accessibility-audit-example",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.14",
    "expo-image": "~58.0.15",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.11",
    "react-native-accessibility-audit": "file:..",
    "react-native-element-dropdown": "^2.12.4",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "react-native-accessibility-audit"
    ],
    "reporters": [
      "default",
      [
        "react-native-accessibility-audit/reporter",
        {
          "outputFile": "a11y-report.json",
          "markdownFile": "a11y-report.md"
        }
      ]
    ]
  }
}
