{
  "name": "react-native-accessibility-audit",
  "version": "0.0.0",
  "description": "Accessibility audits for React Native and Expo tests. A toBeAccessible() Jest matcher for React 19 and React Native Testing Library v14.",
  "license": "MIT",
  "author": "Priyanka Sharma",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "react-native",
    "expo",
    "jest-expo",
    "accessibility",
    "a11y",
    "jest",
    "testing-library",
    "wcag"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "npm run build"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "peerDependencies": {
    "@testing-library/react-native": ">=14.0.0",
    "jest": ">=29.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "test-renderer": "^1.3.1",
    "typescript": "^5.9.3"
  }
}
