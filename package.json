{
  "name": "react-native-accessibility-audit",
  "version": "0.1.0",
  "description": "Accessibility testing for React Native and Expo: a toBeAccessible() Jest matcher (jest-axe for React Native), WCAG 2.2 / EN 301 549 mapped rules, baselines, project reports, a static scanner, a GitHub Action and an AI agent skill.",
  "license": "MIT",
  "author": "Priyanka Sharma",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "default": "./dist/scan.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "react-native-accessibility-audit": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "action.yml",
    "CHANGELOG.md"
  ],
  "keywords": [
    "react-native",
    "expo",
    "jest-expo",
    "accessibility",
    "a11y",
    "jest",
    "testing-library",
    "wcag",
    "en-301-549",
    "european-accessibility-act",
    "voiceover",
    "talkback",
    "screen-reader",
    "jest-axe"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepare": "npm run build",
    "preversion": "node scripts/stamp-changelog.mjs --check && npm run typecheck && npm test -- --ci && npm run build",
    "version": "node scripts/stamp-changelog.mjs && git add CHANGELOG.md",
    "prepublishOnly": "npm run typecheck && npm test -- --ci"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@react-native/normalize-colors": ">=0.72.0"
  },
  "peerDependencies": {
    "@testing-library/react-native": ">=14.0.0",
    "jest": ">=29.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78",
    "test-renderer": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "test-renderer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@react-native-community/slider": "^5.2.1",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-native-gesture-handler": "^3.4.0",
    "test-renderer": "^1.3.1",
    "typescript": "^5.9.3"
  }
}
